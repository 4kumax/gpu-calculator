# Leave DATABASE_URL unset for local browser-only mode.
# Use a dedicated PostgreSQL database; the first authenticated read creates tables.
# The first editor save publishes revision 1. Never prefix credentials with NEXT_PUBLIC_.
DATABASE_URL=

# Generate three DIFFERENT high-entropy secrets, each at least 32 characters.
# Example generator (run separately for each): openssl rand -hex 32
CATALOG_EDITOR_TOKEN=
CATALOG_VIEWER_TOKEN=
CATALOG_SESSION_SECRET=

# These names are audit labels for shared role credentials, not individual identities.
CATALOG_EDITOR_NAME=Редактор
CATALOG_VIEWER_NAME=Читатель
CATALOG_SESSION_TTL_SECONDS=28800

# Optional canonical origin, especially behind a reverse proxy (no path).
# Production requires HTTPS because the session cookie is Secure.
# CATALOG_ALLOWED_ORIGIN=https://gpu.example.org

# Tests only: a disposable dedicated PostgreSQL database, NEVER a production URL.
# TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/gpu_catalog_test
